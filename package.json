{
  "name": "@junjiezhou1122/pi-goal",
  "version": "0.2.3",
  "description": "Persistent autonomous goals for pi — /goal loops until an independent verifier confirms completion or a genuine block; audited completions, findings re-injection, auto-release",
  "type": "commonjs",
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "goal",
    "automation"
  ],
  "files": [
    ".pi/",
    "skills/",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      ".pi/extensions/pi-goal"
    ],
    "skills": [
      "skills"
    ]
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@mariozechner/pi-tui": "*"
  },
  "devDependencies": {
    "jiti": "^2.7.0"
  },
  "scripts": {
    "check": "pi --no-extensions -e ./.pi/extensions/pi-goal/index.ts --list-models __pi_goal_load_check__",
    "test": "node --test test/**/*.test.cjs",
    "pack:dry": "npm pack --dry-run"
  },
  "author": "michaelliv",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/junjiezhou1122/pi-goal.git"
  },
  "homepage": "https://github.com/junjiezhou1122/pi-goal#readme",
  "bugs": {
    "url": "https://github.com/junjiezhou1122/pi-goal/issues"
  }
}
